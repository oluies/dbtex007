MSSQL_SA_PASSWORD=DddSample!Pass1

SRC_MSSQL_HOST=localhost
SRC_MSSQL_PORT=11433
SRC_MSSQL_DB=ddd_source

DST_MSSQL_HOST=localhost
DST_MSSQL_PORT=21433
DST_MSSQL_DB=ddd_dest

SRC_MSSQL_URL=mssql+pymssql://sa:DddSample!Pass1@localhost:11433/ddd_source
DST_MSSQL_URL=mssql+pymssql://sa:DddSample!Pass1@localhost:21433/ddd_dest

SRC_MSSQL_DUCKDB_CONN=Server=localhost,11433;Database=ddd_source;User Id=sa;Password=DddSample!Pass1;TrustServerCertificate=true;Encrypt=false
DST_MSSQL_DUCKDB_CONN=Server=localhost,21433;Database=ddd_dest;User Id=sa;Password=DddSample!Pass1;TrustServerCertificate=true;Encrypt=false

# DuckDB memory controls (see https://duckdb.org/docs/current/guides/performance/oom).
# Defaults are conservative for an 8GB laptop; bump on a workstation.
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREADS=4
DUCKDB_MAX_SPILL=10GB
